# Порт сайта на компьютере.
SERVICEOIL_PORT=8080

# Пароль PostgreSQL для локального запуска. Используется и БД, и приложением.
# Для уже созданного тома смена этой переменной не меняет пароль в самой БД.
SERVICEOIL_DB_PASSWORD=serviceoil_local

# Индекс публикаций Росстата.
ROSSTAT_WEEKLY_INDEX_URL=https://rosstat.gov.ru/compendium/document/50798

# Автоматический импорт выключен по умолчанию
ROSSTAT_WEEKLY_SCHEDULE_ENABLED=false

# Шесть полей cron: секунды, минуты, часы, день месяца, месяц, день недели.
# По умолчанию — каждый четверг в 10:00 по московскому времени.
ROSSTAT_WEEKLY_CRON="0 0 10 * * THU"
ROSSTAT_WEEKLY_ZONE=Europe/Moscow

# Число дней публикаций для повторной проверки при плановом импорте.
ROSSTAT_WEEKLY_LOOKBACK_DAYS=14

# Файл внутри контейнера; относительный путь отсчитывается от /app.
# Каталог /app/logs хранится в отдельном томе serviceoil_logs.
LOGGING_FILE_NAME=logs/serviceoil.log

# DEBUG включает замеры просмотра цен и расчётов; INFO оставляет запуск и импорт.
LOGGING_LEVEL_RU_KRASTTI_LOGGING=INFO

# Размер одного файла до архивирования; хранение архивов — 7 дней, до 100 МБ.
LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE=10MB

# WARN для успешного чтения/расчёта, достигшего порога. 0 — предупреждать о каждом вызове.
SERVICEOIL_SLOW_READ_THRESHOLD_MS=500

# Локальный кеш списка шаблонов: срок жизни в секундах. Значение должно быть больше нуля.
SERVICEOIL_VEHICLE_TEMPLATES_CACHE_TTL_SECONDS=300

# TRACE включает диагностику попаданий/промахов кеша; INFO отключает подробности.
SERVICEOIL_CACHE_LOG_LEVEL=INFO
